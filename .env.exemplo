# Copie este arquivo para ".env" e preencha. O .env fica so na sua maquina.

# Endereco publico do tunel, sem barra no final (muda a cada vez que o tunel reinicia)
URL_PUBLICA=

# Do painel do aplicativo, em "Consultar Aplicativo > Desenvolver"
# APP_UUID e o identificador longo com tracos, NAO o numero curto
APP_UUID=
APP_CLIENT_ID=
APP_CLIENT_SECRET=

# Preenchidos sozinhos pelo comando "instalar". Nao mexa.
MERCHANT_CLIENT_ID=
MERCHANT_CLIENT_SECRET=

# Opcional, para o resumo do testador escrito por IA (sem isso o resumo sai de texto fixo)
OPENROUTER_API_KEY=
# Modelo do resumo. Padrao: google/gemini-2.5-flash-lite
MODELO_RESUMO=
